# Copy to .env for local development (scripts/setup.ps1 does this for you).
# .env is git-ignored. Never put real secrets or API keys in this example file.

APP_ENV=development
# Loopback only. Other values are rejected (approved proposal P-SEC-1).
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=4200
LOG_LEVEL=info

# Generated locally by scripts\setup.ps1; never commit a real value.
LOCAL_AGENT_TOKEN=

# Optional Google sign-in and TOTP step-up. Leave all fields blank to keep
# authentication disabled during local development. Real values stay in .env.
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
MASTER_GOOGLE_SUB=
APP_SESSION_TTL_SECONDS=
GOOGLE_OIDC_REDIRECT_URI=
AUTHENTICATOR_SECRET_PATH=
